# Copy this file to .env and fill in your values. Never commit the real .env file.

# Which LLM to use for generation: "claude" (paid API) or "ollama" (free, runs locally)
LLM_PROVIDER=ollama

# --- Claude (only needed if LLM_PROVIDER=claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# --- Ollama (only needed if LLM_PROVIDER=ollama) ---
# Install from https://ollama.com, then run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
